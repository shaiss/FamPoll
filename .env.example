# Clerk (dashboard.clerk.com -> your app -> API keys). Enable Google, Apple and
# Facebook under "SSO connections" so the sign-in sheet offers all three.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The app passes its own sign-in and sign-up routes to Clerk in code; these
# only need setting if you move those pages.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Any Postgres. On Vercel: Storage -> Create database (Neon) attaches this for you.
DATABASE_URL=

# Brand. The name shows in the wordmark, page titles and share text; both
# are baked in at build time, so changing them means a redeploy.
NEXT_PUBLIC_BRAND_NAME=FamPoll
NEXT_PUBLIC_BRAND_TAGLINE=Family decisions, one round at a time.

# Public address of the deployment, used in invite and share links.
# Optional: when unset the app uses the incoming request's host.
NEXT_PUBLIC_APP_URL=

# In-app feedback -> GitHub issues. All optional: leave unset and the feedback
# form still captures to the database; issues just can't be posted until these
# are present. Server-side only (never NEXT_PUBLIC_ — that would ship the token
# to the browser).
#
# A fine-grained personal access token with "Issues: Read and write" on the one
# target repo, minted under a dedicated machine/bot account so every posted issue
# has a single, uniform author that reveals nothing about who submitted.
GITHUB_FEEDBACK_TOKEN=
# The repo issues are posted to, as owner/repo (e.g. shaiss/fampoll).
GITHUB_FEEDBACK_REPO=
# Optional comma-separated labels applied to every posted issue (default: feedback).
# GITHUB_FEEDBACK_LABELS=feedback
# Comma-separated emails allowed to open the review queue and approve/post feedback.
# Nothing is posted until at least one reviewer is named here.
FEEDBACK_ADMIN_EMAILS=
