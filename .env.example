# Clerk (dashboard.clerk.com -> your app -> API keys). Enable Google, Apple and
# Facebook under "SSO connections" so the sign-in sheet offers all three.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Any Postgres. On Vercel: Storage -> Create database (Neon) attaches this for you.
DATABASE_URL=

# Public address of the deployment, used in invite and share links.
# Optional: when unset the app uses the incoming request's host.
NEXT_PUBLIC_APP_URL=
